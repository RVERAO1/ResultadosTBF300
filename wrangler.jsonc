{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noisy-sea-5a8a",
  "main": "cloudflare_worker_finais.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "CONTROL", "class_name": "CentralControl" }]
  },
  "migrations": [{ "tag": "central-v1", "new_sqlite_classes": ["CentralControl"] }],
  "observability": {
    "enabled": true
  }
}
